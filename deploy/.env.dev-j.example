# Environnement de test dev-j (NAS Synology)
# Copier en « .env » dans le dossier du projet, puis remplacer chaque CHANGE_ME.
#
# Génération des secrets, sur le poste de développement :
#   JWT_SECRET_KEY          openssl rand -hex 32
#   SETTINGS_ENCRYPTION_KEY openssl rand -base64 32
#   mots de passe base      openssl rand -base64 24

# --- Environnement ---
# "staging" désactive la documentation d'API et active la limitation de débit,
# comme en production, sans imposer le contrôle strict du secret JWT au
# démarrage. Ne jamais mettre "development" sur une machine exposée.
APP_ENV=staging
DEBUG=false

# --- Image publiée sur GHCR ---
# Suit la branche : le tag « dev-j » est reconstruit à chaque push sur dev-j.
IMAGE_TAG=dev-j

# --- Domaines et Traefik ---
PUBLIC_HOST=dev-j.bourse.alpe-plaisance.org
MAILHOG_HOST=mailhog.dev-j.bourse.alpe-plaisance.org
TRAEFIK_CERTRESOLVER=letsencrypt

CORS_ORIGINS=https://dev-j.bourse.alpe-plaisance.org
FRONTEND_URL=https://dev-j.bourse.alpe-plaisance.org

# --- Base de données ---
DB_NAME=bourse_devj
DB_USER=bourse
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# --- Sécurité ---
JWT_SECRET_KEY=CHANGE_ME
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# Accès à MailHog, protégé par le middleware basicauth de Traefik.
# Fabriquer la valeur sur le poste de développement :
#   docker run --rm httpd:alpine htpasswd -nbB alpe 'MOT_DE_PASSE'
# puis DOUBLER chaque $ du résultat : Compose interprète un $ isolé comme une
# variable et ampute silencieusement le hash.
#   htpasswd donne  alpe:$2y$10$abc...
#   ici on écrit    alpe:$$2y$$10$$abc...
MAILHOG_BASICAUTH=CHANGE_ME

# --- Courriel ---
# Tout part dans MailHog : aucun message n'atteint de vraie adresse.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@dev-j.bourse.alpe-plaisance.org
SMTP_FROM_NAME=Bourse ALPE (test)
SUPPORT_EMAIL=noreply@dev-j.bourse.alpe-plaisance.org

# --- Limitation de débit ---
# Les participants d'une démonstration sortent souvent par une seule adresse
# publique et partagent donc le même compteur. La valeur de production (100 par
# minute) est vite atteinte à plusieurs.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
