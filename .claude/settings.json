{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(*.env)",
      "Read(*.env.*)",
      "Read(*id_rsa*)",
      "Read(*id_ed25519*)",
      "Read(*id_ecdsa*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.keystore)",
      "Read(*.jks)",
      "Read(*credentials*)",
      "Read(*secret*)",
      "Read(*.htpasswd)",
      "Read(*.netrc)",
      "Read(*token.json)",
      "Read(*serviceAccountKey*)",
      "Read(*.gpg)",
      "Read(*.asc)",

      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *--delete *)",
      "Bash(git push *:refs/*)",
      "Bash(git reset *--hard*)",
      "Bash(git checkout .*)",
      "Bash(git clean *-f*)",
      "Bash(git branch *-D *)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(chmod -R 777*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  }
}
